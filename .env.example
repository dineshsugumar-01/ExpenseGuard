# ==========================================
# ExpenseGuard Environment Configuration
# ==========================================

# --- General System Settings ---
PROJECT_NAME=ExpenseGuard
ENVIRONMENT=development
LOG_LEVEL=INFO
DEFAULT_CURRENCY=INR
APPROVAL_LIMIT=10000.0

# --- Firefly III Configuration ---
# Generate a 32-char APP_KEY: e.g. head /dev/urandom | LC_ALL=C tr -dc 'A-Za-z0-9' | head -c 32
FIREFLY_APP_KEY=SomeRandomStringOf32Characters!!
FIREFLY_SITE_URL=http://firefly:8080
FIREFLY_EXTERNAL_URL=http://localhost:8080
FIREFLY_DB_HOST=firefly-db
FIREFLY_DB_PORT=3306
FIREFLY_DB_DATABASE=firefly
FIREFLY_DB_USERNAME=firefly
FIREFLY_DB_PASSWORD=firefly_secret_pw

# Firefly Personal Access Token (Create from Firefly Profile -> OAuth -> Personal Access Tokens)
FIREFLY_API_TOKEN=your_firefly_personal_access_token_here
FIREFLY_WEBHOOK_SECRET=expenseguard_webhook_secret_key_123

# --- Bridge Database (PostgreSQL 16) ---
BRIDGE_DB_HOST=bridge-db
BRIDGE_DB_PORT=5432
BRIDGE_DB_USER=expenseguard
BRIDGE_DB_PASSWORD=expenseguard_secret_pw
BRIDGE_DB_NAME=expenseguard
DATABASE_URL=postgresql+asyncpg://expenseguard:expenseguard_secret_pw@bridge-db:5432/expenseguard
DATABASE_URL_SYNC=postgresql://expenseguard:expenseguard_secret_pw@bridge-db:5432/expenseguard

# --- Bridge Security & JWT ---
SECRET_KEY=expenseguard_super_secret_jwt_key_change_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# --- ML Anomaly Scorer Settings ---
CONTAMINATION=0.05
MODELS_ENABLED=ecod,iforest
MIN_TX_FOR_CATEGORY_MODEL=30
COLD_START_MIN_ROWS=50

# --- Risk Combiner Thresholds ---
COMBINER_WEIGHT_ECOD=0.5
COMBINER_WEIGHT_IFOREST=0.5
TIER_LOW_MAX=39
TIER_MEDIUM_MAX=69

# --- Alerting & Notifications ---
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=alerts@expenseguard.local
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
ALERT_HIGH_SEVERITY_ONLY=true

# --- Frontend ---
VITE_API_URL=http://localhost:8000
REACT_APP_API_URL=http://localhost:8000
